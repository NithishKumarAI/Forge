FORGE_DATABASE_URL=sqlite:///data/forge.db
FORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUTOR_THINKING=low
GEMINI_DOUBT_THINKING=low
GEMINI_CURRICULUM_THINKING=medium
GEMINI_EXERCISE_THINKING=low
GEMINI_ANSWER_EVALUATION_THINKING=low
GEMINI_INTERVIEW_THINKING=low
GEMINI_INTERVIEW_EVALUATION_THINKING=medium
# Configurable estimates only; update when Google's pricing changes.
GEMINI_INPUT_PRICE_PER_MILLION=0.75
GEMINI_OUTPUT_PRICE_PER_MILLION=3.75
GEMINI_CACHED_INPUT_PRICE_PER_MILLION=0.075
# File paths below are relative to the repository root (absolute overrides are supported).
FORGE_COURSE_CONTENT_PATH=content/ai-engineer/v1
FORGE_COURSE_SOURCES_PATH=data/course-sources.json
FORGE_CURRICULUM_V2_PATH=data/default-interview-curriculum-v2.json
FORGE_CURRICULUM_MIGRATION_PATH=data/curriculum-migrations/v1-to-v2.json

FORGE_CONTENT_BINDINGS_PATH=data/content-bindings/legacy-curricula.json
FORGE_CONTENT_SNAPSHOT_PATH=apps/api/data/content-snapshots
FORGE_DATABASE_BACKUP_PATH=apps/api/data/db-backups
FORGE_PROBLEM_BANK_PATH=content/problem-bank
