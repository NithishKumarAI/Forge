  "hints": [
    "Use a hash map."
  ],
  "explanation": "Iterate and keep track of seen numbers and their indices.",
  "reference_solution": "def two_sum(nums: list[int], target: int) -> list[int]:\n    seen = {}\n    for i, num in enumerate(nums):\n        if target - num in seen:\n            return [seen[target - num], i]\n        seen[num] = i\n    return [0, 0]",
  "complexity": "O(n) time and O(n) space.",
